# FB-Sprint1 02/10/2026: plantilla de variables de entorno.
# Copia este archivo como ".env" y llena los valores reales. El .env NO se sube al repo.
# El doble guion bajo (__) equivale a ":" en la configuración de .NET (Jwt__Key -> Jwt:Key).

ASPNETCORE_ENVIRONMENT=Development

# Base de datos PostgreSQL (la API usa el rol app_backend; su clave de desarrollo la crea Liquibase en contexto dev)
ConnectionStrings__Database=Host=localhost;Port=5432;Database=campusbite;Username=app_backend;Password=app_backend_dev

# JWT (la llave debe tener al menos 32 caracteres)
Jwt__Key=CAMBIAR_POR_UNA_LLAVE_SECRETA_DE_AL_MENOS_32_CARACTERES
Jwt__Issuer=CampusBite.API
Jwt__Audience=CampusBite.PWA
Jwt__ExpirationMinutes=60

# CORS: orígenes del front separados por coma (vacío = permite cualquier origen)
Cors__AllowedOrigins=http://localhost:5173,http://localhost:4200

# Swagger fuera de Development (true/false)
Swagger__Enabled=false

# Límite de intentos de login/registro por IP (opcional)
RateLimit__AuthPermitLimit=20
RateLimit__AuthWindowSeconds=60
