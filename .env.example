# FB-Sprint1 02/10/2026: plantilla de variables de entorno.
# Copia este archivo como ".env" y llena los valores reales. El .env NO se sube al repo.
# El doble guion bajo (__) equivale a ":" en la configuración de .NET (Jwt__Key -> Jwt:Key).

ASPNETCORE_ENVIRONMENT=Development

# JJ-Sprint2 09/10/2026: dos conexiones; Database__Conexion elige cuál usa la API (Local o Produccion).
# Los perfiles de Visual Studio / dotnet run lo fijan solos: "http" y "https" = Local, "https (BD produccion)" = Produccion.
# La API se conecta siempre con el rol app_backend (sin acceso directo a tablas).
Database__Conexion=Local

# Local: base creada con db/consolidado o con Liquibase en contexto dev (la clave app_backend_dev es solo de desarrollo)
ConnectionStrings__Local=Host=localhost;Port=5432;Database=campusbite;Username=app_backend;Password=app_backend_dev

# Producción (Neon): pide la cadena completa al responsable del backend. NUNCA la subas al repo ni la pegues en chats.
ConnectionStrings__Produccion=

# JWT (la llave debe tener al menos 32 caracteres)
Jwt__Key=CAMBIAR_POR_UNA_LLAVE_SECRETA_DE_AL_MENOS_32_CARACTERES
Jwt__Issuer=CampusBite.API
Jwt__Audience=CampusBite.PWA
Jwt__ExpirationMinutes=60

# CORS: ya viene configurado por ambiente en appsettings (front local :4200 y front de producción).
# Descomenta solo si necesitas reemplazarlo (orígenes separados por coma, sin "/" final).
# Cors__AllowedOrigins=http://localhost:4200

# Swagger fuera de Development (true/false)
Swagger__Enabled=false

# Límite de intentos de login/registro por IP (opcional)
RateLimit__AuthPermitLimit=20
RateLimit__AuthWindowSeconds=60
